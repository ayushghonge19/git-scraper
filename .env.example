# =========================================================
# GitHub Memory Assistant - Environment Configuration
# =========================================================

# Google Gemini API Key (Get free key at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-flash-lite-latest

# MongoDB Persistence Configuration (LangGraph Checkpoint Storage)
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=github_memory_assistant

# Composio MCP Configuration (Phase 3 - GitHub Tool Access)
# Get key at: https://app.composio.dev
COMPOSIO_API_KEY=your_composio_api_key_here
# Optional: Specific Composio User ID (defaults to discovering active connected account or 'default')
# COMPOSIO_USER_ID=pg-test-xxxxx

# ---------------------------------------------------------
# Optional: OpenAI API Key (if you ever want to switch)
# ---------------------------------------------------------
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL_NAME=gpt-4o-mini
